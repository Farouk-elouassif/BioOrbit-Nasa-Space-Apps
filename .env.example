DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
BACKEND_PORT=8000
POSTGRES_DB=bioorbit
POSTGRES_USER=bioorbit
POSTGRES_PASSWORD=replace-with-a-random-password

# Simulator: initialization values apply only to a new persistent state.
SIM_MISSION_ID=MARS_001
SIM_HABITAT_ID=HAB_001
SIM_RUN_ID=demo-001
SIM_ASTRONAUTS=3
SIM_ENVIRONMENT=transit_spacecraft
# Percentage of in-flight measurements deliberately made abnormal (0–100).
SIM_ERROR_LEVEL=0
SIM_SEED=42
SIM_START=2026-11-14T00:00:00Z
SIM_DURATION_DAYS=180
SIM_PREFLIGHT_DAYS=14
SIM_HISTORY_DAYS=30
SIM_HISTORY_INTERVAL=300
SIM_SPEED=1
SIM_EMIT_INTERVAL=5
SIM_BATCH_SIZE=500
SIM_HTTP_TIMEOUT=10
SIM_HTTP_RETRIES=3
# Simulator sends to the Django ingestion endpoint; shared token is required.
# When ready: http://backend:8000/api/v1/ingest/events
SIM_INGEST_URL=http://backend:8000/api/v1/ingest/events
SIM_INGEST_TOKEN=replace-with-a-random-ingestion-token



# Frontend origins allowed to acknowledge alerts (add your LAN origin if needed).
# If opening Vite from another device, append its exact LAN origin (scheme, address, port).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
