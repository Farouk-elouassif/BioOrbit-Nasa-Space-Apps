{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BioOrbit event batch",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
